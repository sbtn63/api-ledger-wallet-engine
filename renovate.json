{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "release/dev"
  ],
  "timezone": "America/Bogota",
  "dependencyDashboard": true,
  "rust": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  }
}